
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    // LEADS
    // Anyone can create a lead. Only admins can read/manage them.
    match /leads/{leadId} {
      allow create: if true;
      allow read, list, update, delete: if isAdmin();
    }

    // USER DATA
    // Users can manage their own profile. Admins can manage any user.
    match /users/{userId} {
      allow read, update: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow list: if isAdmin();
      allow delete: if false; // Users should not be deletable from the client
    }
    
    // ADVERTISEMENTS (TICKET SYSTEM)
    // Only admins can read, write, or list the advertisement records.
    // Creation would ideally be handled by a Cloud Function.
    match /advertisements/{advertisementId} {
        allow read, write, list: if isAdmin();
        allow create: if isAdmin(); // Allow admins to create manually if needed
    }

    // STRIPE CUSTOMER DATA & ALL SUBCOLLECTIONS
    // A user can manage their own customer data, and so can an admin.
    // This includes checkout_sessions, subscriptions, and portal_links.
    match /customers/{userId} {
        allow read, write: if isOwner(userId) || isAdmin();
    }

    // Comments on subscriptions can only be managed by admins.
    match /customers/{userId}/subscriptions/{subscriptionId}/comments/{commentId} {
        allow read, list, create: if isAdmin();
        allow update, delete: if false; // Comments are immutable
    }

    // All other subcollections under /customers/{userId}
    match /customers/{userId}/{allDocuments=**} {
        allow read, write: if isOwner(userId) || isAdmin();
    }
    
    // PUBLIC & ADMIN-MANAGED DATA
    // These collections are readable by anyone, but only writable by admins.
    match /communityWebsites/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /communityWebsites/{websiteId}/adCampaigns/{adCampaignId} {
        allow read, write: if isAdmin();
    }

    // EMAIL TEMPLATES
    // Only admins can read or write email templates.
    match /emailTemplates/{templateId} {
      allow read, list, write: if isAdmin();
    }
    
    // STRIPE PRODUCTS & PLANS
    // These collections are managed in Stripe and synced to Firestore.
    // They should be publicly readable but not writable by any client.
    match /plans/{planId} {
      allow read: if true;
      allow write: if false;

      match /prices/{priceId} {
        allow read: if true;
        allow write: if false;
      }
    }
    
    match /products/{productId} {
      allow read: if true;
      allow write: if false;

      match /prices/{priceId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ADMIN ROLES
    // Only admins can view or modify the list of other admins.
    match /roles_admin/{userId} {
      allow read, write, list: if isAdmin();
    }

    // EMAIL TRIGGER
    // Any authenticated user can create a document in the /mail collection.
    // The Trigger Email extension will then process this document.
    match /mail/{mailId} {
      allow create: if isSignedIn();
      allow read, update, delete, list: if false; // Only the extension should read/delete
    }
  }
}

service firebase.storage {
  match /b/{bucket}/o {
    // Files for advertisements: User can only write to their own folder.
    // Admins can read any file.
    match /advertisements/{userId}/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isOwner(userId);
    }
  }
}

    