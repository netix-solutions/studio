
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Check if the user has a document in the roles_admin collection.
      // This matches the app-level admin check in layout.tsx.
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    // LEGAL DOCUMENTS
    // Anyone can read, only admins can write.
    match /legalDocuments/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // LEADS
    // Anyone can create a lead.
    // Signed-in users can read/query/update leads (needed for lead-to-customer conversion during registration).
    // Only admins can delete leads.
    match /leads/{leadId} {
      allow create: if true;
      // Allow signed-in users to read and query leads for registration conversion
      // This enables the auth.ts lead lookup by email and conversion marking
      allow read, list, update: if isSignedIn();
      allow delete: if isAdmin();

      // Lead activities subcollection
      // Admins have full access; converted customers can create tracking activities
      match /activities/{activityId} {
        allow read, list: if isAdmin();
        // Allow admins to create any activity, or allow the converted customer
        // to create page_visit/login tracking activities on their own lead
        allow create: if isAdmin() || (
          isSignedIn() &&
          get(/databases/$(database)/documents/leads/$(leadId)).data.convertedToCustomerId == request.auth.uid &&
          request.resource.data.type in ['page_visit', 'login'] &&
          request.resource.data.createdBy == request.auth.uid
        );
        allow update, delete: if false; // Activities are immutable
      }
    }

    // USER DATA
    // Users can manage their own profile. Admins can manage any user.
    // Note: Admins can create users via the Admin SDK (bypasses rules) for manual entry.
    match /users/{userId} {
      allow read, update: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow delete: if isAdmin(); // Only admins can delete users

      // ADVERTISEMENT TICKETS
      // Users can create/read/update their own tickets. Admins can manage all tickets.
      match /advertisements/{advertisementId} {
        // Grant create/read/update access to owners and admins.
        // List is handled by the collectionGroup rule below.
        allow create, read, update: if isOwner(userId) || isAdmin();
        // Only admins can delete advertisements
        allow delete: if isAdmin();

        // DESIGN VERSIONS
        // Users can create/read/update their own design versions. Admins can manage all.
        match /versions/{versionId} {
          allow create, read, update, list: if isOwner(userId) || isAdmin();
          allow delete: if isAdmin();
        }
      }
    }
    
    // This rule allows admins to perform a collectionGroup query on 'advertisements'
    // across all users, which is necessary for the main admin advertisements page.
    match /{path=**}/advertisements/{adId} {
      allow list: if isAdmin();
    }

    // STRIPE CUSTOMER DATA & ALL SUBCOLLECTIONS
    // A user can manage their own customer data, and so can an admin.
    // This includes checkout_sessions, subscriptions, and portal_links.
    match /customers/{userId} {
        allow read, write: if isOwner(userId) || isAdmin();
    }

    // Comments on subscriptions can be read by owners and admins, but only admins can create.
    match /customers/{userId}/subscriptions/{subscriptionId}/comments/{commentId} {
        allow read, list: if isOwner(userId) || isAdmin();
        allow create: if isAdmin();
        allow update, delete: if false; // Comments are immutable
    }

    // Subscriptions collection group for admin view
    match /{path=**}/subscriptions/{subscriptionId} {
        allow list: if isAdmin();
    }

    // All other subcollections under /customers/{userId}
    match /customers/{userId}/{allDocuments=**} {
        allow read, write: if isOwner(userId) || isAdmin();
    }
    
    // PUBLIC & ADMIN-MANAGED DATA
    // These collections are readable by anyone, but only writable by admins.
    match /communityWebsites/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /communityWebsites/{websiteId}/adCampaigns/{adCampaignId} {
        allow read, write: if isAdmin();
    }

    // EMAIL TEMPLATES
    // Only admins can read or write email templates.
    match /emailTemplates/{templateId} {
      allow read, list, write: if isAdmin();
    }

    // ADMIN NOTIFICATION SETTINGS
    // Only admins can read or write notification settings.
    match /admin_notifications/{settingId} {
      allow read, list, write: if isAdmin();
    }
    
    // STRIPE PLANS & PRICES
    // These collections are managed in Stripe and synced to Firestore.
    // They should be publicly readable but not writable by any client.
    match /plans/{planId} {
      allow read, list: if true;
      allow write: if false;

      match /prices/{priceId} {
        allow read, list: if true;
        allow write: if false;
      }
    }

    // ADMIN ROLES
    // A user can check their own admin status. Only admins can modify roles.
    match /roles_admin/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write, list: if isAdmin();
    }

    // EMAIL TRIGGER
    // Anyone can create a document in the /mail collection.
    match /mail/{mailId} {
      allow create: if true;
      allow read, update, delete, list: if false; // Only the extension should read/delete
    }

    // SENT EMAILS LOG
    // Anyone can create a log entry. Users can read emails sent to them. Admins can read all.
    match /sent_emails/{emailId} {
      allow create: if isSignedIn();
      // Users can read emails where they are the recipient, admins can read all
      allow read, list: if isAdmin() || (isSignedIn() && resource.data.recipientId == request.auth.uid);
      allow update, delete: if false;
    }

    // LIVE ADS (Ad Server)
    // Public read access for serving ads to external websites.
    // Only admins can create/update/delete ads.
    match /live_ads/{adId} {
      allow read, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // AD EVENTS (Impressions & Clicks)
    // Anyone can create events (for tracking).
    // Only admins can read analytics.
    match /ad_events/{eventId} {
      allow create: if true;
      allow read, list: if isAdmin();
      allow update, delete: if false;
    }

    // SCHEDULED LEAD EMAILS
    // Only admins can manage scheduled lead emails
    match /scheduledLeadEmails/{emailId} {
      allow read, list, create, update, delete: if isAdmin();
    }
  }
}
