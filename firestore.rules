
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read, update: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow list: if isAdmin();
      allow delete: if false;

      match /adSubscriptions/{adSubscriptionId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    match /communityWebsites/{communityWebsiteId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /adCampaigns/{adCampaignId} {
        allow read, write: if isAdmin();
      }
    }
    
    match /discountOffers/{discountOfferId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /plans/{planId} {
      allow read: if true;
      allow write: if false;

      match /prices/{priceId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /customers/{userId} {
      allow read, create, update: if isOwner(userId) || isAdmin();

      // Explicitly allow read access to subscriptions for the owner or an admin
      match /subscriptions/{subscriptionId} {
        allow read: if isOwner(userId) || isAdmin();
      }

      // Allow creating checkout sessions and portal links for the owner or an admin
      match /checkout_sessions/{sessionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /portal_links/{portalId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    match /roles_admin/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      allow list: if isAdmin();
    }
  }
}
