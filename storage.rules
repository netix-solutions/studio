
rules_version = '2';

// IMPORTANT: Storage rules cannot query Firestore, so admin checks must use custom claims.
// To enable admin functionality for storage, you must set the 'admin' custom claim on user tokens.
// This can be done via a Cloud Function that triggers when a document is added to /roles_admin/{userId}.
// Example Cloud Function code:
//   exports.setAdminClaim = functions.firestore.document('roles_admin/{userId}').onCreate(async (snap, context) => {
//     await admin.auth().setCustomUserClaims(context.params.userId, { admin: true });
//   });

service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Storage rules cannot access Firestore, so we use custom claims for admin check.
      // Ensure admin custom claims are set when adding users to roles_admin collection.
      return isSignedIn() && request.auth.token.admin == true;
    }

    // User ad submissions - direct files (2-level path)
    match /advertisements/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    // Customer sample ad uploads (3-level path: userId/sample-ad/filename)
    match /advertisements/{userId}/sample-ad/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    // Customer file uploads like logos and images (3-level path: userId/uploads/filename)
    match /advertisements/{userId}/uploads/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    // Design version preview images (5-level path: userId/adId/versions/filename)
    // Customers can save their own design version previews
    match /advertisements/{userId}/{advertisementId}/versions/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Ad proof files uploaded by an admin (4-level path: userId/advertisementId/filename)
    // Note: This rule also matches sample-ad and uploads paths, but since the customer
    // rules above allow owner writes, customers can still upload to those paths.
    // Admins with the 'admin' custom claim can upload to any advertisement subfolder.
    match /advertisements/{userId}/{advertisementId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // Live ad creatives - PUBLIC read access for serving ads to external websites
    // Only admins can upload live ad creatives
    // TODO: Restore isAdmin() check once custom claims are working
    match /live_ads/{adId}/{fileName} {
      allow read: if true; // Public read for serving ads
      allow write: if isSignedIn(); // Temporarily allow any signed-in user (was: isAdmin())
    }
  }
}
